NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# JWT Secrets & Expiry
JWT_SECRET=ecommerce_super_secure_jwt_access_secret_key_2026_xyz123
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=ecommerce_super_secure_refresh_secret_key_2026_xyz123
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Payment Gateways (Mock / Sandbox keys)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_12345
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=mock_razorpay_secret_key

# Admin Seed Defaults
ADMIN_NAME=Admin Master
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=Admin@123456
